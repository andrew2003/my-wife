{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/tsbuildinfo",
    "jsx": "preserve",
    "resolveJsonModule": true,
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "esModuleInterop": true
  },
  "include": [
    "app",
    "components",
    "lib",
    "next-env.d.ts",
    "test",
    "vitest.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
