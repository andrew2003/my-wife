
# INTAKE FORM - fill in once, complete over time
# scripts/run.sh copies this file to factory/INTAKE.env (that file is NEVER committed).
# Fill in factory/INTAKE.env. Format: NAME=value, no quotes needed.
#
# Tags:
#   [REQUIRED]    scripts/run.sh test and run will not pass without it
#   [BEFORE M1]   needed before you acceptance-test the first demo; agents use emulators until then
#   [BEFORE M2]   needed before you acceptance-test Sheets and Calendar sync
#   [OPTIONAL]    leave empty to use the default shown
#   [GENERATED]   leave empty; the factory generates it
# scripts/run.sh status always lists what is still missing for the upcoming milestone.
# Do not paste the secret values in this file into an AI chat.

# == A. PROJECT ============================================================
# [REQUIRED] Technical name (lowercase, hyphens) used for packages and containers
PROJECT_NAME=my-wife
# [OPTIONAL] Display name in the UI
PRODUCT_DISPLAY_NAME=My Wife
# [REQUIRED] GitHub user or organization that owns the repository
GITHUB_OWNER=
# [REQUIRED] Repository name
GITHUB_REPO=my-wife
# [OPTIONAL] private | public (default private)
GITHUB_VISIBILITY=private
# [OPTIONAL] yes: agents may create the repository if it does not exist. no: you create it and add the origin remote
GITHUB_CREATE_REPO=yes
# [REQUIRED] Identity recorded in commits
GIT_USER_NAME=
GIT_USER_EMAIL=
# [REQUIRED] Default time zone of the product
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
# [OPTIONAL] Default UI locale (default vi). Source code, comments, docs and commits are always English;
# UI text lives in locale files (vi and en are both generated).
UI_LANGUAGE=vi
# [BEFORE M1] Email of the first admin account (you)
ADMIN_EMAIL=

# == B. OPEN PRODUCT CHOICES ===============================================
# [OPTIONAL] Web sign-in method: google | chat_link (a sign-in link sent through Telegram/Discord). Default: google
LOGIN_METHOD=google
# [OPTIONAL] Default first day of the week: monday | sunday (each user can change it)
WEEK_START=monday
# [OPTIONAL] Banks you use, comma-separated (agents prioritize them when testing)
BANKS_USED=Vietcombank

# == C. DEMO INFRASTRUCTURE (Cloudflare) ===================================
# [BEFORE M1] The domain you bought, for example: yourname.dev
DOMAIN=
# [OPTIONAL] The web app is served at https://<APP_SUBDOMAIN>.<DOMAIN> (default mywife)
APP_SUBDOMAIN=mywife
# [OPTIONAL] Bank emails are forwarded to *@<MAIL_SUBDOMAIN>.<DOMAIN> (default in)
MAIL_SUBDOMAIN=in
# [BEFORE M1] From the Cloudflare dashboard overview
CLOUDFLARE_ACCOUNT_ID=
# [BEFORE M1] API token with edit permission for: DNS, Cloudflare Tunnel, Email Routing, Workers
CLOUDFLARE_API_TOKEN=
# [OPTIONAL] this_server: deploy the demo on this machine through Cloudflare Tunnel. none: do not deploy
DEPLOY_TARGET=this_server

# == D. CHAT CHANNELS ======================================================
# [BEFORE M1] Create a bot with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# [BEFORE M1] Create an application in the Discord Developer Portal
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# == E. GOOGLE =============================================================
# [BEFORE M2] OAuth client (type: Web application) for Sheets and Calendar.
# Needed earlier (before M1) when LOGIN_METHOD=google.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# == F. LLM FOR THE BOT (your own API key, for acceptance testing) =========
# This key is for the My Wife bot, NOT for Claude Code.
# It can come from the API credits included with the Max plan (see FACTORY.md).
# [OPTIONAL] anthropic | openai | deepseek | google (default anthropic)
LLM_PROVIDER=anthropic
# [BEFORE M1]
LLM_API_KEY=
# [OPTIONAL] Leave empty to let agents pick a sensible default for the provider
LLM_MODEL_CHAT=
# [OPTIONAL] A model that accepts images, used for the wake-up check-in photo
LLM_MODEL_VISION=

# == G. GENERATED ==========================================================
# [GENERATED] Created when the demo environment is set up and written back here
APP_ENCRYPTION_KEY=
SESSION_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
POSTGRES_PASSWORD=

# == H. REAL TEST DATA =====================================================
# [OPTIONAL] Put bank receipt .eml files (with account numbers and names REDACTED) in this folder
# so agents can use them as fixtures for receipt parsing.
FIXTURE_EMAIL_DIR=factory/fixtures/emails
