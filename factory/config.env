# FACTORY CONFIGURATION (no secrets; committed to git)
# Edit at any time; changes take effect from the next cycle.

# -- MODEL PER AGENT -------------------------------------------------------
# Values: sonnet | opus | haiku | fable | or a full model name.
# Everything defaults to sonnet. Percentages are estimated shares of the total
# workload (not measured).
# Suggested upgrade order if you have usage to spare:
#   ARCHITECT -> REVIEWER -> SPEC_AUDITOR -> BUILDER_CORE
# Higher models consume the plan limit faster; check with /usage in Claude Code.

# Lead orchestrator: reads state, dispatches work, integrates results (~8%, medium)
MODEL_LEAD=sonnet
# Architect: domain specs, contracts, backlog, ADRs, arbitration (~6%, hardest) - upgrade first
MODEL_ARCHITECT=sonnet
# Spec auditor: finds contradictions and gaps before each milestone (~1%, hard, rare) - cheap, high value
MODEL_SPEC_AUDITOR=sonnet
# Product owner proxy: answers builders' product questions from the spec (~2%, medium)
MODEL_PO=sonnet
# Core builder: money rules, penalties, cycle state machine, receipt parsing (~19%, hard)
MODEL_BUILDER_CORE=sonnet
# Service builder: CRUD services, chat adapters, sync, infrastructure (~21%, medium)
MODEL_BUILDER_SERVICE=sonnet
# Web builder: Next.js UI (~19%, medium)
MODEL_BUILDER_WEB=sonnet
# Realtime builder: per-second timer, in-browser camera analysis, WebSocket (~7%, hard: browser quirks)
MODEL_BUILDER_REALTIME=sonnet
# Reviewer: reviews every PR, reads diffs only (~9%, hard) - upgrade second
MODEL_REVIEWER=sonnet
# QA: writes and runs the four end-to-end scenarios (~7%, medium)
MODEL_QA=sonnet
# Scribe: progress journal and handoff documents (~1%, easy) - can be lowered to haiku
MODEL_SCRIBE=sonnet

# Fallback model(s) when the primary is overloaded (empty to disable). Example: sonnet,haiku
FALLBACK_MODEL=

# -- PACE ------------------------------------------------------------------
# Maximum number of issues worked on in parallel within one cycle.
# auto picks from installed RAM: under 12 GB -> 1, under 24 GB -> 2, under 48 GB -> 3, otherwise 4.
# A 16 GB machine therefore runs 2 builders at a time. Set a number to override.
MAX_PARALLEL=auto
# Do not start a cycle while less than this much memory (MB) is available; wait instead.
# If memory stays low for 10 minutes, the cycle runs with one issue at a time.
MIN_FREE_MEM_MB=2500
# Milestones where the factory pauses for your review: any of M1,M2,M3,M4
HANDOFF_AT=M1,M4
# yes: merge automatically when every gate is green. no: leave PRs for you to merge
AUTO_MERGE=yes
# full: issues, pull requests and CI on GitHub. local: local git only, gh not needed
GITHUB_MODE=full
# Language for the files written for you (questions, handoff notes, progress journal).
# These files are local and never committed. The codebase itself is always English.
OWNER_LANGUAGE=vi

# -- AGENT PERMISSIONS -----------------------------------------------------
# auto: a classifier reviews each action instead of you (recommended).
# bypassPermissions: skips all checks - ONLY inside an isolated container or VM.
PERMISSION_MODE=auto
# none: nobody answers permission prompts; anything that would prompt is denied and the agent moves on
PERMISSION_PROMPTS=none
# Maximum agentic turns per cycle (empty = unlimited)
MAX_TURNS=
# Extra flags for the claude command (advanced; normally empty)
CLAUDE_EXTRA_ARGS=

# -- WAITING AND SAFETY ----------------------------------------------------
# Pause between two cycles (seconds)
COOLDOWN_SECONDS=20
# While waiting for your answers, how often to check again (seconds)
POLL_SECONDS=30
# Consecutive cycles without progress before the factory asks you for help
MAX_STALLED=3
# When Claude Code fails (usually the usage limit), wait this many minutes before each retry
BACKOFF_MINUTES=5,15,30,60
