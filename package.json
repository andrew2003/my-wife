{
  "name": "my-wife",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate:service": "node scripts/generate-service.mjs",
    "dev": "pnpm --filter @my-wife/dev-runner start",
    "demo:reset": "pnpm --filter @my-wife/dev-runner demo:reset",
    "test": "turbo run test --concurrency=2",
    "typecheck": "turbo run typecheck --concurrency=2",
    "lint": "turbo run lint --concurrency=2",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:root": "eslint scripts *.mjs",
    "prepare": "husky",
    "test:scripts": "node --test scripts/test/"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.74.0"
  }
}
