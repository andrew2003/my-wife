# Copy to .env for local runs. Never commit real values.
UI_LANGUAGE=vi
LOGIN_METHOD=google
DATABASE_URL=postgres://mywife:mywife@localhost:5432/mywife
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379
# Per-branch isolation inside the shared stack (own database name, own subject prefix)
NATS_SUBJECT_PREFIX=
# 32+ characters; use a secret store outside local development
SESSION_SECRET=change-me-change-me-change-me-change-me
